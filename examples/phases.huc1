// Staged HUC1 example; all numbered constructs disappear in emitted HUC0.
module examples.phases;

import std.io as io;
import2 compiler;

// All let2 storage and every numbered construct disappear in generated HUC0.
let2 BuildDiagnostics: bool = true;

// Module-scope phase control inserts a module declaration at this position.
if1 (BuildDiagnostics) {
    fn build_mode() -> c8* {
        return "diagnostic";
    }
} else {
    this skipped body is deliberately not valid HUC !!!
}

// Phase control inside a type selects fields before its runtime layout is checked.
struct Report {
    if1 (BuildDiagnostics) {
        let mod messages: u64;
    } else {
        let mod messages: u32;
    }
}

// A structure family has one primary, a pointer partial specialization, and a
// bool full specialization. Requests use angle brackets.
struct1 Cell(T: auto) {
    let mod value: T;
}

struct1 Cell(T: auto)<T*>(true) {
    let mod value: T*;
}

struct1 Cell()<bool> {
    let mod value: bool;
}

struct1 CountedCell(T: auto, Count: usize) {
    let mod value: T;
    let count: usize = Count;

    fn capacity() -> usize {
        return this->count;
    }
}

// Function families use the same primary/partial/full pattern syntax.
fn1 describe(T: auto)(value: T) -> c8* {
    return "value";
}

fn1 describe(T: auto)<T*>(true)(value: T*) -> c8* {
    if (value) {
        return "non-null pointer";
    }
    return "null pointer";
}

fn1 describe()<bool>(value: bool) -> c8* {
    if (value) {
        return "true";
    }
    return "false";
}

// The first list contains phase binders; the second contains runtime
// parameters. if1 selects runtime syntax while ordinary if remains runtime.
fn1 choose(T: auto, Greater: bool = true)(mod left: T, mod right: T) -> T {
    if1 (Greater) {
        if (left > right) {
            return left;
        }
        return right;
    } else {
        if (left < right) {
            return left;
        }
        return right;
    }
}

struct2 BuildRecord {
    let2 generated_declarations: usize;
    let2 used_text_generation: bool;
}

// An ordinary scalar function can also run in the compiler evaluator.
// Its runtime definition still remains in HUC0 even if only used by fn2.
fn add_values(left: i32, right: i32) -> i32 {
    // Local generated code is parsed in both program and evaluation mode.
    @compiler::emit_huc("let sum: i32 = left + right;");
    return sum;
}

fn2 add_at_compile_time(left: i32, right: i32) -> i32 {
    return add_values(left, right); // Already in compiler execution: no extra @.
}

// This compiler helper writes code where it is called, not here beside its
// definition.
fn2 declare_local_counter() -> void {
    compiler::emit_huc("let mod generated_counter: i32 = 0;");
}

// At module scope, the generated declaration is inserted after this request.
@compiler::emit_huc_module(
    "fn generated_answer() -> i32 { return 42; }",
);

fn main() -> i32 {
    let left: i32 = 3;
    let right: i32 = 5;

    // Normal fn1 calls produce and call concrete runtime functions.
    let greater: i32 = choose<i32, true>(left, right);
    io::println(greater);
    io::println(describe<i32>(greater));

    let mod integer_cell: Cell<i32>;
    integer_cell.value = greater;

    let mod pointer_cell: Cell<i32*>;
    pointer_cell.value = &integer_cell.value;
    io::println(describe<i32*>(pointer_cell.value));

    let mod bool_cell: Cell<bool>;
    bool_cell.value = true;
    io::println(describe<bool>(bool_cell.value));

    let mod buffer: CountedCell<i32, 4>;
    buffer.value = left + right;
    io::println(buffer.capacity());

    // One variable family can produce different runtime let declarations.
    let1 slot(T: auto) {
        let slot: T = T();
    }

    let1 slot(T: auto)<T*>(true) {
        let mod slot: T* = null;
    }

    let1 slot()<bool> {
        let mod slot: bool = false;
    }

    io::println(slot<i32>);
    slot<i32*> = pointer_cell.value;
    slot<bool> = true;

    // @ runs the whole call at compile time and inserts the result as a literal.
    let folded: i32 = @add_at_compile_time(20, 22);
    // This specialization is compile-time-only, unlike choose<i32, true> above.
    // Its body is checked and evaluated, but no runtime definition is needed.
    let smaller: i32 = @choose<i32, false>(3, 5);
    io::println(folded + smaller);

    // The helper inherits this generation site. HUC1 parses its output before
    // checking the following use; HUC0 independently checks the printed program.
    @declare_local_counter();
    generated_counter += 1;

    if1 (BuildDiagnostics) {
        io::println(build_mode());
    }

    return generated_counter + generated_answer();
}
