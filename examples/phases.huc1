// Staged HUC1 example; all numbered constructs disappear in emitted HUC0.
module examples.phases;

import std.io as io;
import1 compiler;

// All let1 storage and every numbered construct disappear in generated HUC0.
let1 BuildDiagnostics: bool = true;

// Module-scope phase control inserts a module declaration at this position.
if1 (BuildDiagnostics) {
    fn build_mode() -> c8* {
        return "diagnostic";
    }
} else {
    this skipped body is deliberately not valid HUC !!!
}

// Phase control inside a type selects fields before its runtime layout is checked.
struct Report {
    if1 (BuildDiagnostics) {
        let mod messages: u64;
    } else {
        let mod messages: u32;
    }
}

// A structure family has one primary, a pointer partial specialization, and a
// bool full specialization. Requests use angle brackets.
struct Cell<T: auto> {
    let mod value: T;
}

struct Cell<T: auto><T*> {
    let mod value: T*;
}

struct Cell<><bool> {
    let mod value: bool;
}

struct CountedCell<T: auto, Count: usize> {
    // Validate the selected body; a failed check does not try another definition.
    if1 (Count == 0) {
        @compiler::error("CountedCell requires a nonzero Count");
    }
    let mod value: T;
    let count: usize = Count;

    fn capacity() -> usize {
        return this->count;
    }
}

// Function families use the same primary/partial/full pattern syntax.
fn describe<T: auto>(value: T) -> c8* {
    return "value";
}

fn describe<T: auto><T*>(value: T*) -> c8* {
    if (value) {
        return "non-null pointer";
    }
    return "null pointer";
}

fn describe<><bool>(value: bool) -> c8* {
    if (value) {
        return "true";
    }
    return "false";
}

// The angle list contains phase binders; parentheses contain runtime
// parameters. if1 selects runtime syntax while ordinary if remains runtime.
fn choose<T: auto, Greater: bool = true>(mod left: T, mod right: T) -> T {
    if1 (Greater) {
        if (left > right) {
            return left;
        }
        return right;
    } else {
        if (left < right) {
            return left;
        }
        return right;
    }
}

struct BuildRecord<> {
    let generated_declarations: usize;
    let used_text_generation: bool;
}

// An ordinary scalar function can also run in the compiler evaluator.
// Its runtime definition remains in HUC0 even if only used by compiler calls.
fn add_values(left: i32, right: i32) -> i32 {
    // Inserted local code is parsed in both program and evaluation mode.
    #compiler::local("let sum: i32 = left + right;");
    return sum;
}

fn add_at_compile_time<>(left: i32, right: i32) -> i32 {
    return add_values(left, right); // Already in compiler execution: no extra @.
}

// A code builder returns code; the # that uses it decides where it goes.
fn counter_decl<>() -> compiler::Code {
    return compiler::local("let mod generated_counter: i32 = 0;");
}

// Both value evaluation and runtime preparation keep this local inside answer.
fn answer<>() -> i32 {
    #compiler::local("let result: i32 = 42;");
    return result;
}

// At module scope, the generated declaration is inserted after this item.
#compiler::module("fn generated_answer() -> i32 { return 42; }");

fn main() -> i32 {
    let left: i32 = 3;
    let right: i32 = 5;

    let answer_folded: i32 = @answer();
    let answer_explicit: i32 = @answer<>(); // Same zero-binder call.
    let answer_live: i32 = answer();
    io::println(answer_folded, answer_explicit, answer_live);

    // Normal generic fn calls produce and call concrete runtime functions.
    let greater: i32 = choose(left, right); // Deduce T; Greater defaults to true.
    io::println(greater);
    io::println(describe(greater)); // Call-site angles are optional when deduced.

    let mod integer_cell: Cell<i32>;
    integer_cell.value = greater;

    let mod pointer_cell: Cell<i32*>;
    pointer_cell.value = &integer_cell.value;
    io::println(describe<i32*>(pointer_cell.value));

    let mod bool_cell: Cell<bool>;
    bool_cell.value = true;
    io::println(describe<bool>(bool_cell.value));

    let mod buffer: CountedCell<i32, 4>;
    buffer.value = left + right;
    io::println(buffer.capacity());

    // One variable family can produce different runtime let declarations.
    let slot<T: auto> {
        let slot: T = T();
    }

    let slot<T: auto><T*> {
        let mod slot: T* = null;
    }

    let slot<><bool> {
        let mod slot: bool = false;
    }

    io::println(slot<i32>);
    slot<i32*> = pointer_cell.value;
    slot<bool> = true;

    // @ runs the whole call at compile time and writes the result as a literal.
    let folded: i32 = @add_at_compile_time(20, 22);
    // This specialization is compile-time-only, unlike choose<i32, true> above.
    // Its body is checked and evaluated, but no runtime definition is needed.
    let smaller: i32 = @choose<i32, false>(3, 5);
    io::println(folded + smaller);

    // The # inserts the returned code here. HUC1 parses it before checking the
    // following use; HUC0 independently checks the printed program.
    #counter_decl();
    generated_counter += 1;

    if1 (BuildDiagnostics) {
        io::println(build_mode());
    }

    return generated_counter + generated_answer();
}
