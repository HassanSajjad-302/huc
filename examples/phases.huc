module examples.phases;

import std.io as io;

fn1 choose(bool greater = true)(auto left, auto right) -> auto {
    if1 (greater) {
        if (left > right) {
            return left;
        }
        return right;
    } else {
        if (left < right) {
            return left;
        }
        return right;
    }
}

fn1 print_all(auto... arguments) -> void {
    for1 (auto argument : arguments) {
        gen {
            io::println($(argument));
        }
    }
}

struct1 FixedBuffer(Type T, usize count) {
    let [count]T mod values;
}

export fn main() -> i32 {
    let i32 left = 3;
    let i32 right = 5;

    // Generates and calls one concrete choose[true](i32, i32).
    io::println(choose[true](left, right));

    // Runs the same staged function completely during translation.
    io::println(@choose[false](3, 5));

    // Generates a concrete function with three runtime parameters.
    print_all(7, 2.5, "HUC");

    let FixedBuffer[i32, 16] mod buffer;
    buffer.values[0] = 11;
    return 0;
}
