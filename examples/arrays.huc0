module examples.arrays;

// Self-contained array and byte-storage checks: main returns 0 on success.
let mut drop_order: i32;

struct Probe {
    let id: i32;

    fn init(&mut self, id: i32) : id = id {
    }

    fn drop(&mut self) -> void {
        drop_order = drop_order * 10 + self.id;
    }
}

struct InlineProbes {
    let [align(align_of<Probe>()), nozero] mut storage: u8[2 * size_of<Probe>()];
    let mut length: usize;

    fn init(&mut self) {
        // No Probe is constructed. length starts at zero.
    }

    // Precondition: length < 2. The parameter is consumed by this call.
    fn push(&mut self, mut value: Probe) -> void {
        let slots: mut Probe* = ptr_as<mut Probe*>(&self.storage[0]);
        construct_at(slots + self.length, value);
        self.length += 1;
    }

    // Precondition: length > 0.
    fn pop(&mut self) -> Probe {
        let last: usize = self.length - 1;
        let mut result: Probe = *(ptr_as<mut Probe*>(&self.storage[0]) + last);
        self.length = last; // exclude the inactive source slot
        return result;
    }

    fn drop(&mut self) -> void {
        let slots: mut Probe* = ptr_as<mut Probe*>(&self.storage[0]);
        while (self.length > 0) {
            self.length -= 1;
            destruct_at(slots + self.length);
        }
        // Automatic byte-array field cleanup performs no Probe drops.
    }
}

fn main() -> i32 {
    if (size_of<Probe[2]>() != 2 * size_of<Probe>()) {
        return 1;
    }
    if (align_of<Probe[2]>() != align_of<Probe>()) {
        return 2;
    }
    if (!is_basic<i32>() || is_basic<Probe>() ||
        !is_basic<i32[1]>() || is_basic<Probe[2]>()) {
        return 3;
    }

    {
        let mut buffer: InlineProbes = InlineProbes();
        buffer.push(Probe(1));
        buffer.push(Probe(2));
        let removed: Probe = buffer.pop();
        if (removed.id != 2 || drop_order != 0) {
            return 4;
        }
        let relocated: InlineProbes = buffer;
        // No cached self-pointer: element addresses are recomputed after moving.
        if (relocated.length != 1) {
            return 5;
        }
    } // relocated drops 1, then removed drops 2; buffer is inactive
    if (drop_order != 12) {
        return 6;
    }

    drop_order = 0;
    {
        let mut buffer: InlineProbes = InlineProbes();
        buffer.push(Probe(3));
        buffer.push(Probe(4));
    } // reverse initialized-range cleanup: 4, then 3
    if (drop_order != 43) {
        return 7;
    }

    {
        let [nozero] mut numbers: i32[1];
        let slot: mut i32* = &numbers[0];
        construct_at(slot, 10);
        let old: i32 = *slot; // Basic copy: source remains live
        construct_at(slot, 20); // live Basic lifetime ends without cleanup
        if (old != 10 || *slot != 20) {
            return 8;
        }
    }
    let mut pair: i32[2] = [1, 2];
    pair = [pair[1], pair[0]]; // Basic replacement is ready before either store.
    if (pair[0] != 2 || pair[1] != 1) {
        return 9;
    }
    let grid: auto = [[1, 2, 3], [4, 5, 6]]; // i32[3][2]
    let grid_pointer: i32[3][2]* = &grid;
    if ((*grid_pointer)[1][2] != 6) {
        return 10;
    }
    let mut zeros: i32[2];
    if (zeros[0] != 0 || zeros[1] != 0) {
        return 11;
    }

    drop_order = 0;
    {
        let probes: Probe[2] = [Probe(5), Probe(6)];
    } // Automatic reverse element cleanup.
    if (drop_order != 65) {
        return 12;
    }
    return 0;
}
