// Runtime-only HUC0 example.
module examples.value_semantics;

import std.io as io;
import std.memory as memory;

// Point is Basic: every field is Basic and it declares neither clone nor drop.
struct Point {
    let i32 x;
    let i32 y;

    fn init(i32 x, i32 y)
        : x(x),
          y(y) {
    }
}

// NativeBuffer is Advanced because it declares clone and drop.
struct NativeBuffer {
    let mod u8* mod data;
    let usize size;

    fn init(usize size)
        : data(memory::allocate_zeroed_bytes(size)),
          size(size) {
    }

    fn first() -> u8 {
        if (this->size == 0) {
            return 0;
        }
        return this->data[0];
    }

    fn fill(u8 value) mod -> void {
        memory::fill_bytes(this->data, value, this->size);
    }

    // Only an explicit copy expression selects this method.
    fn clone() -> NativeBuffer {
        let NativeBuffer mod result = NativeBuffer(this->size);
        memory::copy_bytes(result.data, this->data, this->size);
        return result;
    }

    // The compiler invokes this before reverse field cleanup.
    fn drop() mod -> void {
        if (this->data) {
            memory::free_raw_bytes(this->data, this->size);
            this->data = null;
        }
    }
}

// Packet is Advanced because of its owner field, despite having no clone or drop.
struct Packet {
    let i32 tag;
    let NativeBuffer& mod payload;

    fn init(i32 tag, NativeBuffer& mod payload)
        : tag(tag),
          payload(payload) {
    }
}

// AddressDependent is Advanced because its empty drop suppresses implicit copying.
// Its self pointer makes inline destructive relocation invalid unless the
// programmer can prove the pointer will never be used afterward.
struct AddressDependent {
    let AddressDependent* mod self;

    fn init() : self(null) {
        this->self = this;
    }

    fn drop() mod -> void {
    }
}

fn receive(NativeBuffer* observed, NativeBuffer& owned) -> u8 {
    // owned keeps the allocation alive for the duration of this call.
    if (!owned) {
        return 0;
    }
    return observed->first();
} // owned is dropped here

fn demonstrate_copy_values() -> void {
    let Point first = Point(10, 20);
    let Point second = first;       // implicit fieldwise copy
    let Point third = copy second;  // equivalent for a Basic type

    io::println(first.x, second.x, third.x);
}

fn demonstrate_inline_relocation() -> void {
    let NativeBuffer mod original = NativeBuffer(64);
    original.fill(7);

    let NativeBuffer duplicate = copy original; // invokes the clone protocol
    // Fixed bitwise relocation transfers the representation without a user
    // move/relocation constructor. original's lifetime ends; neither its drop
    // nor its field cleanup runs, and its storage is now inactive.
    let NativeBuffer mod relocated = original;

    relocated = relocated;         // exact self-relocation is a no-op
    original = NativeBuffer(32);    // reinitializes inactive storage

    let NativeBuffer mod target = NativeBuffer(8);
    // Clone a temporary, drop old target, then relocate the replacement.
    target = copy duplicate;

    io::println(duplicate.first(), relocated.first(), target.first());
}

fn demonstrate_owner_values() -> void {
    let mod NativeBuffer& mod buffer = new NativeBuffer(128);
    buffer->fill(42);

    let NativeBuffer* observer = buffer;
    let NativeBuffer& duplicate = copy buffer; // deep owner copy

    // Arguments are evaluated left-to-right. The observer is captured first;
    // ownership is then relocated into receive's second parameter.
    let u8 first_byte = receive(buffer, buffer);
    // buffer is null and observer is dangling after receive returns.

    io::println(first_byte, duplicate->first());
}

fn demonstrate_embedded_owners() -> void {
    let Packet mod source = Packet(1, new NativeBuffer(16));
    let Packet mod destination = source;
    // source and source.payload are inactive. No payload null store or source
    // cleanup is required. Only destination owns the transferred buffer.
    io::println(destination.tag, destination.payload->first());

    // Moving a field individually is different: destination stays active,
    // and its payload slot becomes an active null owner.
    let NativeBuffer& extracted = destination.payload;
    io::println(!destination.payload, extracted->first());

    // A null embedded owner does not prevent whole-value relocation.
    let Packet mod empty = Packet(2, null);
    let Packet relocated_empty = empty;
    io::println(relocated_empty.tag, !relocated_empty.payload);
} // extracted destroys the buffer once; neither inactive Packet is cleaned up.

fn demonstrate_address_stability() -> void {
    // Relocating an inline AddressDependent would leave its self pointer aimed
    // at inactive source storage. HUC neither repairs nor diagnoses that
    // unchecked contract. Put it behind T& so only the owner address relocates.
    let AddressDependent& mod first = new AddressDependent();
    let AddressDependent& second = first;
    let AddressDependent* observer = second;

    io::println(second->self == observer);
}

fn main() -> i32 {
    demonstrate_copy_values();
    demonstrate_inline_relocation();
    demonstrate_owner_values();
    demonstrate_embedded_owners();
    demonstrate_address_stability();
    return 0;
}
