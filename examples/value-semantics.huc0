// Runtime-only HUC0 example.
module examples.value_semantics;

import std.io as io;
import std.memory as memory;

// Point is Basic: every field is Basic and it declares neither clone nor drop.
struct Point {
    let x: i32;
    let y: i32;

    fn init(x: i32, y: i32)
        : x(x),
          y(y),
    {
    }
}

// NativeBuffer is Advanced because it declares clone and drop.
struct NativeBuffer {
    let mod data: mod u8*;
    let size: usize;

    fn init(size: usize)
        : data(memory::allocate_zeroed_bytes(size)),
          size(size),
    {
    }

    fn first() -> u8 {
        if (this->size == 0) {
            return 0;
        }
        return this->data[0];
    }

    fn fill(value: u8) mod -> void {
        memory::fill_bytes(this->data, value, this->size);
    }

    // Only an explicit copy expression calls this method.
    fn clone() -> NativeBuffer {
        let mod result: NativeBuffer = NativeBuffer(this->size);
        memory::copy_bytes(result.data, this->data, this->size);
        return result;
    }

    // The compiler calls this, then cleans up fields in reverse order.
    fn drop() mod -> void {
        if (this->data) {
            memory::free_raw_bytes(this->data, this->size);
            this->data = null;
        }
    }
}

// Packet is Advanced because of its Advanced field, despite having no clone or drop.
struct Packet {
    let tag: i32;
    let mod payload: NativeBuffer;

    fn init(tag: i32, mod payload: NativeBuffer)
        : tag(tag),
          payload(payload),
    {
    }
}

// The empty drop makes AddressDependent Advanced and prevents implicit copying.
// Transferring it inline leaves a stale self pointer. This is invalid unless the
// programmer can prove the pointer will never be used afterward.
struct AddressDependent {
    let mod self: AddressDependent*;

    fn init() : self(null) {
        this->self = this;
    }

    fn drop() mod -> void {
    }
}

fn receive(buffer: NativeBuffer) -> u8 {
    return buffer.first();
} // buffer is dropped here

// A helper for future manually managed container storage, not automatic arrays.
// Preconditions: data holds *length live NativeBuffers, *length > 0,
// and length points to separate writable container bookkeeping.
// The caller must destroy only the remaining initialized prefix afterward.
// Pointer extraction does not cancel automatic cleanup through aliases.
// Do not use this helper on an automatic local and then let that inactive
// local be destroyed. Raw-storage construction/destruction APIs are deferred,
// so main does not allocate backing storage for this helper yet.
fn pop_last_buffer(data: mod NativeBuffer*, length: mod usize*) -> NativeBuffer {
    let last: usize = *length - 1;
    let mod result: NativeBuffer = *(data + last);
    // The old slot is inactive. Extraction neither clears it nor changes data.
    *length = last;
    return result; // direct local transfer suppresses result's cleanup here
}

fn demonstrate_copy_values() -> void {
    let first: Point = Point(10, 20);
    let second: Point = first; // implicit fieldwise copy
    let third: Point = copy second; // equivalent for a Basic type

    io::println(first.x, second.x, third.x);
}

fn demonstrate_inline_relocation() -> void {
    let mod original: NativeBuffer = NativeBuffer(64);
    original.fill(7);

    let duplicate: NativeBuffer = copy original; // calls clone
    // Bitwise relocation transfers the stored value without calling user code.
    // original becomes inactive: its lifetime ends, and neither its drop nor
    // its field cleanup runs.
    let mod relocated: NativeBuffer = original;

    relocated = relocated; // exact self-relocation is a no-op
    original = NativeBuffer(32); // reinitializes inactive storage

    let mod target: NativeBuffer = NativeBuffer(8);
    // Clone a temporary, drop old target, then relocate the replacement.
    target = copy duplicate;

    io::println(duplicate.first(), relocated.first(), target.first());
}

fn demonstrate_observation_and_consumption() -> void {
    let mod buffer: NativeBuffer = NativeBuffer(128);
    buffer.fill(42);

    let observer: NativeBuffer* = &buffer;
    let duplicate: NativeBuffer = copy buffer;
    io::println(observer->first());

    let first_byte: u8 = receive(buffer);
    // buffer is inactive; observer must not be dereferenced afterward.
    io::println(first_byte, duplicate.first());
}

fn demonstrate_advanced_fields() -> void {
    let mod source: Packet = Packet(1, NativeBuffer(16));
    let destination: Packet = source;
    // source and source.payload are inactive. Only destination cleans up.
    io::println(destination.tag, destination.payload.first());

    // Direct transfer out of a field is not allowed. Explicit cloning leaves
    // the field active and gives the new local an independent value.
    let duplicate: NativeBuffer = copy destination.payload;
    io::println(duplicate.first());
} // duplicate and destination.payload release their separate buffers

fn demonstrate_address_stability() -> void {
    // Keep this object at its construction address. Relocation would leave
    // its self pointer aimed at inactive source storage.
    let fixed: AddressDependent = AddressDependent();
    let observer: AddressDependent* = &fixed;
    let second_observer: AddressDependent* = observer;
    io::println(second_observer->self == observer);
}

fn main() -> i32 {
    demonstrate_copy_values();
    demonstrate_inline_relocation();
    demonstrate_observation_and_consumption();
    demonstrate_advanced_fields();
    demonstrate_address_stability();
    return 0;
}
