// Runtime-only HUC0 example.
module examples.value_semantics;

import std.io as io;
import std.memory as memory;

// Point is Basic: every field is Basic and it declares neither clone nor drop.
struct Point {
    let x: i32;
    let y: i32;

    fn init(x: i32, y: i32)
        : x(x),
          y(y),
    {
    }
}

// NativeBuffer is Advanced because it declares clone and drop.
struct NativeBuffer {
    let mod data: mod u8*;
    let size: usize;

    fn init(size: usize)
        : data(memory::allocate_zeroed_bytes(size)),
          size(size),
    {
    }

    fn first() -> u8 {
        if (this->size == 0) {
            return 0;
        }
        return this->data[0];
    }

    fn fill(value: u8) mod -> void {
        memory::fill_bytes(this->data, value, this->size);
    }

    // Only an explicit copy expression calls this method.
    fn clone() -> NativeBuffer {
        let mod result: NativeBuffer = NativeBuffer(this->size);
        memory::copy_bytes(result.data, this->data, this->size);
        return result;
    }

    // The compiler calls this, then cleans up fields in reverse order.
    fn drop() mod -> void {
        if (this->data) {
            memory::free_raw_bytes(this->data, this->size);
            this->data = null;
        }
    }
}

// Packet is Advanced because of its owner field, despite having no clone or drop.
struct Packet {
    let tag: i32;
    let mod payload: NativeBuffer#;

    fn init(tag: i32, mod payload: NativeBuffer#)
        : tag(tag),
          payload(payload),
    {
    }
}

// The empty drop makes AddressDependent Advanced and prevents implicit copying.
// Transferring it inline leaves a stale self pointer. This is invalid unless the
// programmer can prove the pointer will never be used afterward.
struct AddressDependent {
    let mod self: AddressDependent*;

    fn init() : self(null) {
        this->self = this;
    }

    fn drop() mod -> void {
    }
}

fn receive(observed: NativeBuffer*, owned: NativeBuffer#) -> u8 {
    // owned keeps the allocation alive for the duration of this call.
    if (!owned) {
        return 0;
    }
    return observed->first();
} // owned is dropped here

fn demonstrate_copy_values() -> void {
    let first: Point = Point(10, 20);
    let second: Point = first; // implicit fieldwise copy
    let third: Point = copy second; // equivalent for a Basic type

    io::println(first.x, second.x, third.x);
}

fn demonstrate_inline_relocation() -> void {
    let mod original: NativeBuffer = NativeBuffer(64);
    original.fill(7);

    let duplicate: NativeBuffer = copy original; // calls clone
    // Bitwise relocation transfers the stored value without calling user code.
    // original becomes inactive: its lifetime ends, and neither its drop nor
    // its field cleanup runs.
    let mod relocated: NativeBuffer = original;

    relocated = relocated; // exact self-relocation is a no-op
    original = NativeBuffer(32); // reinitializes inactive storage

    let mod target: NativeBuffer = NativeBuffer(8);
    // Clone a temporary, drop old target, then relocate the replacement.
    target = copy duplicate;

    io::println(duplicate.first(), relocated.first(), target.first());
}

fn demonstrate_owner_values() -> void {
    let mod buffer: mod NativeBuffer# = new NativeBuffer(128);
    buffer->fill(42);

    let observer: NativeBuffer* = buffer;
    let duplicate: NativeBuffer# = copy buffer; // deep owner copy

    // Arguments are evaluated left-to-right. The observer is captured first;
    // ownership is then relocated into receive's second parameter.
    let first_byte: u8 = receive(buffer, buffer);
    // buffer is null and observer is dangling after receive returns.

    io::println(first_byte, duplicate->first());
}

fn demonstrate_embedded_owners() -> void {
    let mod source: Packet = Packet(1, new NativeBuffer(16));
    let mod destination: Packet = source;
    // source and source.payload are inactive. No source cleanup runs, and the
    // payload need not be set to null. Only destination owns the buffer.
    io::println(destination.tag, destination.payload->first());

    // Moving a field individually is different: destination stays active,
    // and its payload slot becomes an active null owner.
    let extracted: NativeBuffer# = destination.payload;
    io::println(!destination.payload, extracted->first());

    // A null embedded owner does not prevent whole-value relocation.
    let mod empty: Packet = Packet(2, null);
    let relocated_empty: Packet = empty;
    io::println(relocated_empty.tag, !relocated_empty.payload);
} // extracted destroys the buffer once; neither inactive Packet is cleaned up.

fn demonstrate_address_stability() -> void {
    // Relocating an inline AddressDependent would leave its self pointer aimed
    // at inactive source storage. HUC does not repair it or diagnose the problem.
    // Store it behind T# so only the owner address is transferred.
    let mod first: AddressDependent# = new AddressDependent();
    let second: AddressDependent# = first;
    let observer: AddressDependent* = second;

    io::println(second->self == observer);
}

fn main() -> i32 {
    demonstrate_copy_values();
    demonstrate_inline_relocation();
    demonstrate_owner_values();
    demonstrate_embedded_owners();
    demonstrate_address_stability();
    return 0;
}
