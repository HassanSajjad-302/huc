// Runtime-only HUC0 example.
module examples.ownership;

import std.io as io;

// probable_open_widget and probable_close_widget stand in for a future
// platform or standard-library resource API.
struct Widget {
    let value: i32;
    let mod native_handle: i32;

    fn init(value: i32)
        : value(value),
          native_handle(probable_open_widget(value)),
    {
    }

    // This customizes explicit `copy`. Declaring clone makes Widget Advanced.
    fn clone() -> Widget {
        return Widget(this->value); // opens an independent native handle
    }

    // This customizes destruction. Fields are cleaned after drop returns.
    fn drop() mod -> void {
        if (this->native_handle >= 0) {
            probable_close_widget(this->native_handle);
            this->native_handle = -1;
        }
    }
}

fn inspect(widget: Widget*) -> void {
    io::println(widget->value);
}

fn consume(widget: Widget) -> void {
    inspect(&widget);
} // widget calls Widget.drop here

fn main() -> i32 {
    let mod first: Widget = Widget(42);
    inspect(&first);
    inspect(&first);

    // Relocation transfers the representation and cleanup responsibility.
    // first and its fields become inactive; no source cleanup runs.
    let mod second: Widget = first;
    let independent: Widget = copy second; // clone opens a separate handle

    let observer: Widget* = &second;
    let another_observer: Widget* = observer; // copies the address unchanged
    inspect(another_observer);

    consume(second);
    // second is inactive. Neither observer may be used to access it now.

    first = Widget(11); // begins a new lifetime in the inactive source
    inspect(&first);
    inspect(&independent);
    return 0;
} // independent and the reinitialized first are destroyed
