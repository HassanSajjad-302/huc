// Runtime-only HUC0 example.
module examples.ownership;

import std.io as io;

// probable_open_widget and probable_close_widget stand in for a future
// platform or standard-library resource API.
struct Widget {
    let value: i32;
    let mod native_handle: i32;

    fn init(value: i32)
        : value(value),
          native_handle(probable_open_widget(value)),
    {
    }

    // This customizes explicit `copy`. Declaring clone makes Widget Advanced.
    fn clone() -> Widget {
        return Widget(this->value); // opens an independent native handle
    }

    // This customizes destruction. Fields are cleaned after drop returns.
    fn drop() mod -> void {
        if (this->native_handle >= 0) {
            probable_close_widget(this->native_handle);
            this->native_handle = -1;
        }
    }
}

fn inspect(widget: Widget*) -> void {
    io::println(widget->value);
}

fn consume(widget: Widget#) -> void {
    inspect(widget);
} // widget owns its argument and calls Widget.drop here

fn main() -> i32 {
    let mod first: Widget# = new Widget(42);

    inspect(first);
    inspect(first);

    let observer: Widget* = first;
    // Transferring an owner copies one address and sets the source to null.
    // Unlike an inline Advanced source, first stays active and usable as null.
    let mod second: Widget# = first;

    // first is now null. observer still points at the Widget owned by second.
    let independent: Widget# = copy second; // allocates a Widget and uses clone

    consume(second);
    // second is null. Its former Widget was dropped, so observer is dangling.

    // Taking ownership from a fixed raw pointer does not clear its address.
    let mod original: Widget# = new Widget(11);
    let raw: Widget* = release(original); // original becomes null
    let mod restored: Widget# = raw; // takes ownership; raw is unchanged
    inspect(raw); // observes the Widget now owned by restored

    // Assignment uses the same rule and first cleans up the old destination.
    let mod replacement: Widget# = new Widget(12);
    let replacement_raw: Widget* = release(replacement);
    restored = replacement_raw; // drops Widget(11); raw is now dangling
    inspect(replacement_raw); // unchanged observer of Widget(12)

    // An owner parameter can also take ownership from a raw pointer.
    let argument: Widget* = release(restored);
    consume(argument); // argument stays unchanged, but is now dangling

    inspect(independent);
    return 0;
} // restored is null; independent destroys its separately cloned Widget
