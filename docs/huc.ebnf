(* HUC design-draft grammar. Implementation release 0.1 may support only a
   documented subset; unsupported syntax must be diagnosed explicitly.

   HUC0 and HUC1 have separate start symbols. Productions whose names end in
   "-0" are accepted by the standalone HUC0 parser. Productions whose names
   end in "-1" are accepted only by the HUC1 staging parser.

   During indexing, a deferred-body is scanned only to find its matching outer
   brace. The scanner accounts for nested braces, literals, and comments; it
   does not turn the body into tokens. If selected, the body is parsed later
   using the grammar for its enclosing module, type, function, or block.
   A family declaration's attribute list is scanned the same way, to its
   matching outer bracket, and parsed only with the selected body.

   HUC1 parses inserted text using the applicable HUC0 productions: generated
   text cannot contain numbered constructs, @, or #. When an insertion-item's
   code has a hole, the next original block-1 fills it; parse the text around
   the hole and that block together as complete items. The language
   specification section 11 defines generation modes and forward insertion.

   Semantic restrictions such as phase availability, fixed-global
   initialization, family partial ordering, and address-taking permissions are
   defined by the language specification, not by this grammar alone. *)

huc0-compilation-unit
                  = module-decl, { runtime-import }, { module-item-0 },
                    { module-section-0 } ;

huc1-compilation-unit
                  = module-decl, { import-decl-1 }, { module-item-1 },
                    { module-section-1 } ;

module-section-0 = module-decl, { module-item-0 } ;
module-section-1 = module-decl, { module-item-1 } ;

(* All imports form one block directly after the file's first module
   declaration; later sections have none. Imports process source once in the
   same translation unit, preserving lexical namespaces. A later module
   declaration opens a namespace section: the file's own namespace, or a
   visible module's namespace for specializations only. It does not create a
   compilation boundary. Flattened HUC0 has no imports: namespace sections and
   canonical qualified names preserve source order. *)

module-decl       = "module", qualified-module-name, ";" ;
runtime-import    = [ "pub" ], "import", qualified-module-name,
                    [ "as", identifier ], ";" ;
compiler-import   = "import1", qualified-module-name,
                    [ "as", identifier ], ";" ;
import-decl-1     = runtime-import | compiler-import ;

(* "pub import" also re-exports the module; there is no "pub import1".
   "as _" binds no alias. Importing one module twice in a file, by any import
   form or alias, is a semantic error. *)

qualified-module-name
                  = identifier, { ".", identifier } ;
symbol-path       = identifier, { "::", identifier } ;

(* ---------- HUC0 module and type declarations ---------- *)

module-item-0     = [ "pub" ], runtime-declaration-0 ;

(* A top-level declaration is private to its file unless marked "pub".
   Structure members are always public and take no "pub". Specializations
   take no "pub"; that is a semantic error, not a grammar rule. *)

runtime-declaration-0
                  = function-decl-0
                  | struct-decl-0
                  | global-let-decl-0
                  | type-alias-decl-0
                  | extern-function-decl-0 ;

function-decl-0   = function-signature-0, ( block-0 | ";" ) ;
function-signature-0
                  = "fn", [ attribute-list-0 ], identifier, parameter-list-0,
                    [ "mut" ], "->", type-0 ;

constructor-decl-0
                  = "fn", [ attribute-list-0 ], "init", parameter-list-0,
                    [ constructor-initializer-list-0 ], block-0 ;

constructor-initializer-list-0
                  = ":", field-initializer-0,
                    { ",", field-initializer-0 }, [ "," ] ;
field-initializer-0
                  = identifier, argument-list-0 ;

struct-decl-0     = "struct", [ attribute-list-0 ], identifier, "{",
                    { struct-member-0 }, "}", [ ";" ] ;
struct-member-0   = field-decl-0
                  | function-decl-0
                  | constructor-decl-0 ;

field-decl-0      = "let", [ attribute-list-0 ], [ "mut" ], identifier,
                    ":", type-0,
                    [ "=", expression-0 ], ";" ;
global-let-decl-0 = field-decl-0 ;

type-alias-decl-0 = "type", identifier, "=", type-0, ";" ;

extern-function-decl-0
                  = "extern", string-literal,
                    function-signature-0, ";" ;

(* ---------- HUC1 module and type declarations ---------- *)

module-item-1     = [ "pub" ], ( runtime-declaration-1
                               | generic-family-decl
                               | global-let1-decl )
                  | phase-control-item
                  | phase-expression-item
                  | compiler-assignment-item
                  | insertion-item ;

runtime-declaration-1
                  = function-decl-1
                  | struct-decl-1
                  | global-let-decl-1
                  | type-alias-decl-1
                  | extern-function-decl-1 ;

function-decl-1   = function-signature-1, ( block-1 | ";" ) ;
function-signature-1
                  = "fn", [ attribute-list-1 ], identifier, parameter-list-1,
                    [ "mut" ], "->", type-1 ;

constructor-decl-1
                  = "fn", [ attribute-list-1 ], "init", parameter-list-1,
                    [ constructor-initializer-list-1 ], block-1 ;

constructor-initializer-list-1
                  = ":", field-initializer-1,
                    { ",", field-initializer-1 }, [ "," ] ;
field-initializer-1
                  = identifier, argument-list-1 ;

struct-decl-1     = "struct", [ attribute-list-1 ], identifier, "{",
                    { struct-member-1 }, "}", [ ";" ] ;
struct-member-1   = field-decl-1
                  | function-decl-1
                  | constructor-decl-1
                  | generic-function-decl
                  | phase-control-item
                  | phase-expression-item
                  | compiler-assignment-item
                  | insertion-item ;

field-decl-1      = "let", [ attribute-list-1 ], [ "mut" ], identifier,
                    ":", type-1,
                    [ "=", expression-1 ], ";" ;
global-let-decl-1 = field-decl-1 ;
type-alias-decl-1 = "type", identifier, "=", type-1, ";" ;

extern-function-decl-1
                  = "extern", string-literal,
                    function-signature-1, ";" ;

(* ---------- Generic families ---------- *)

generic-family-decl
                  = generic-function-decl
                  | generic-struct-decl
                  | generic-let-decl ;

generic-function-decl
                  = "fn", [ deferred-attribute-list ], identifier,
                    generic-header,
                    parameter-list-1, [ "mut" ], "->", type-1,
                    deferred-body ;

generic-struct-decl
                  = "struct", [ deferred-attribute-list ], identifier,
                    generic-header,
                    deferred-body ;

generic-let-decl  = "let", [ deferred-attribute-list ], identifier,
                    generic-header,
                    deferred-body ;

(* A selected generic-let header's attributes precede those of the single
   ordinary let produced by its body. Check the combined list on that runtime
   variable, including duplicates; neither list overrides the other.
   Evaluate the header list before the body, and do not evaluate either list
   again when combining them (specification 9.4). *)

generic-header   = phase-binder-list, [ phase-pattern-list ] ;

phase-binder-list = "<", [ phase-binder,
                    { ",", phase-binder }, [ "," ] ], ">" ;
phase-binder      = identifier, ":", ( "auto" | type-1 ),
                    [ "=", expression-1 ] ;

phase-pattern-list
                  = "<", phase-argument,
                    { ",", phase-argument }, [ "," ], ">" ;

(* After a declaration name, '<' starts a deferred declaration. The first
   angle list always declares binders; the optional second supplies the
   specialization pattern. '<>' alone is a zero-binder primary; '<><i32>'
   is a full specialization, and '<T: auto><T*>' is a partial specialization.
   Diagnose '<T>' in a declaration with a hint for '<T: auto>' or '<><T>'.
   Declaration headers have no 'if1' condition; use 'if1' inside a body. Parenthesize
   '<' and '>' comparisons in angle-list value expressions and defaults.
   Runtime overload sets and generic families cannot share a name in one scope. *)

phase-argument-list
                  = "<", [ phase-argument,
                    { ",", phase-argument }, [ "," ] ], ">" ;
phase-argument    = type-pattern | expression-1 ;

type-pattern      = [ "mut" ], type-pattern-primary, { "*" } ;
type-pattern-primary
                  = builtin-type
                  | raw-storage-pattern
                  | symbol-path, [ phase-argument-list ] ;
raw-storage-pattern
                  = "raw_storage", "<", type-pattern, ",", phase-argument,
                    [ "," ], ">" ;

(* A binder may appear more than once in one pattern; it then matches only
   identical arguments. A binder followed by a phase-argument-list in a
   pattern stands for a family. These are semantic rules. *)

(* Open-ended phase packs are deferred pending a separate design. *)

(* ---------- Compiler-only storage ---------- *)

(* fn and struct with a generic-header stay deferred, even with no binders.
   Their runtime definitions are demand-driven. Without a generic-header,
   functions and types are prepared when encountered. Methods/constructors
   in a deferred type are reached only when that type body is selected.
   fn1 and struct1 are not declaration keywords. Fields and working locals
   use let; let1 explicitly declares storage used during preparation. *)

let1-binding      = "let1", [ "mut" ], identifier, ":", ( type-1 | "auto" ),
                    [ "=", expression-1 ] ;
let1-decl         = let1-binding, ";" ;
global-let1-decl  = let1-decl ;

(* Module-level let1 objects have stable identities and per-module compiler
   state. Imports merge completed states in source order; later object values
   win. Ordinary assignments and pointer writes affect only the active state.
   No separate configuration keyword or declaration form is needed. *)

(* ---------- Phase control and erased expression items ---------- *)

phase-control-item
                  = phase-if-item
                  | phase-for-item
                  | phase-while-item ;

phase-if-item     = "if1", "(", expression-1, ")", deferred-body,
                    [ "else", deferred-body ] ;
phase-for-item    = "for1", "(", [ phase-for-init ], ";",
                    [ expression-1 ], ";", [ for-updates-1 ], ")",
                    deferred-body ;
phase-for-init    = let1-binding | expression-1 ;
phase-while-item  = "while1", "(", expression-1, ")", deferred-body ;

phase-expression-item
                  = "@", unary-expression-1, ";" ;
compiler-assignment-item
                  = unary-expression-1, assignment-op, expression-1, ";" ;
insertion-item    = "#", expression-1, ";" ;

(* A compiler-assignment-item is an assignment at module or type-body scope
   that runs in the compiler and is then erased. At module scope it runs in
   source order; in a type body it runs when that type body is prepared. Its
   target must be compiler storage: a let1 mut, or a place reached from
   compiler storage through fields or pointers. Runtime fields and runtime
   let globals are not targets. Both sides are compiler code. It cannot have
   pub. *)

(* A phase-expression-item evaluates its expression in the compiler; it must
   have type void or never, and it inserts no code. An insertion-item's expression is
   compiler code of type compiler::Code; the item inserts that code here (its
   module parts after the insertion anchor). If the code has a hole, the next
   source item must be a block-1, which fills it. Inside an @ or # operand,
   and in other compiler-only clauses, nested value calls need no further @.
   At compiler-call argument boundaries, runtime-dependent expressions instead
   bind as descriptions; an explicit inner @ requests evaluation of that
   subexpression under specification 9.7.1. These are semantic checks on the AST. *)

deferred-body     = "{", ? scanner-delimited opaque source span ?, "}" ;

(* A selected deferred body is parsed according to where it appears in the
   source. A module or type body may mix runtime declarations or members with
   compiler-only statements. A function or nested block uses the ordinary
   mixed HUC1 block grammar. The phase checker, not this grammar, checks
   whether an ordinary expression or control statement uses only values
   available at compile time. Such a statement runs during preparation and
   disappears from the output. *)

selected-module-body
                  = "{", { module-item-1
                    | compiler-statement-1 }, "}" ;
selected-type-body
                  = "{", { struct-member-1
                    | compiler-statement-1 }, "}" ;
selected-function-or-block-body
                  = block-1 ;

compiler-statement-1
                  = compiler-block-1
                  | let1-decl
                  | phase-control-item
                  | phase-expression-item
                  | compiler-if-statement-1
                  | compiler-while-statement-1
                  | compiler-for-statement-1
                  | "break", ";"
                  | "continue", ";"
                  | expression-statement-1 ;
compiler-block-1  = "{", { compiler-statement-1 }, "}" ;
compiler-if-statement-1
                  = "if", "(", expression-1, ")",
                    compiler-block-1,
                    [ "else", ( compiler-block-1 | compiler-if-statement-1 ) ] ;
compiler-while-statement-1
                  = "while", "(", expression-1, ")",
                    compiler-block-1 ;
compiler-for-statement-1
                  = for-header-1, compiler-block-1 ;

(* ---------- Types ---------- *)

type-0            = [ "mut" ], type-primary-0, { "*" } ;
type-primary-0    = builtin-type | symbol-path | raw-storage-type-0 ;
raw-storage-type-0
                  = "raw_storage", "<", type-0, ",", integer-literal,
                    [ "," ], ">" ;

type-1            = [ "mut" ], type-primary-1, { "*" } ;
type-primary-1    = builtin-type
                  | raw-storage-type-1
                  | symbol-path, [ phase-argument-list ] ;
raw-storage-type-1
                  = "raw_storage", "<", type-1, ",", expression-1,
                    [ "," ], ">" ;

builtin-type      = "bool" | "c8"
                  | "i8" | "i16" | "i32" | "i64" | "isize"
                  | "u8" | "u16" | "u32" | "u64" | "usize"
                  | "f32" | "f64" | "void" | "never" ;

(* A type may end in any number of * suffixes. The type-primary rules do
   not include a suffix, so pointer chains are parsed as repeated suffixes.
   & is not a type suffix; it remains an expression operator.
   Named HUC0 types never have phase arguments. raw_storage<T, N> is a
   built-in type form, not a phase family. Its count is a positive integer
   literal in HUC0; HUC1 resolves its compile-time count to such a literal.
   Parse its count with the same angle-delimiter handling as phase arguments. *)

(* ---------- Attributes ---------- *)

attribute-list-0  = "[", attribute-0, { ",", attribute-0 }, [ "," ], "]" ;
attribute-0       = identifier, [ "(", [ attribute-argument-0,
                    { ",", attribute-argument-0 }, [ "," ] ], ")" ] ;
attribute-argument-0
                  = integer-literal | identifier ;

attribute-list-1  = "[", attribute-entry-1, { ",", attribute-entry-1 },
                    [ "," ], "]" ;
attribute-entry-1 = attribute-1
                  | "#", expression-1 ;
attribute-1       = identifier, [ "(", [ expression-1,
                    { ",", expression-1 }, [ "," ] ], ")" ] ;

deferred-attribute-list
                  = "[", ? scanner-delimited opaque source span ?, "]" ;

(* An attribute list directly follows its keyword: struct, fn (including
   init and foreign declarations), let, if, else, while, or for. A parameter's
   list precedes the parameter. Attribute names are recognized only inside a
   list and are not reserved words. Each built-in attribute defines whether an
   argument is an integer or an option name; an identifier argument in HUC0 is
   an option name, never a variable. In HUC1 an integer argument may be any
   compiler expression; expansion writes a literal.

   A "#" entry is one complete expression-1 of type compiler::Code; the token
   after it must be "," or "]". Commas and brackets inside the expression do
   not end the entry. Its text must parse as zero or more attribute-0 items.
   Empty results drop their separators; a list left empty is omitted, so
   HUC0 never contains "[]".

   To tell a family from an ordinary declaration, skip a balanced attribute
   list after fn, struct, or let and check for "<" after the name. A family
   keeps its list as a deferred-attribute-list. Unknown names, placement,
   conflicts, and argument ranges are semantic checks (specification 4.9). *)

(* ---------- Parameters and blocks ---------- *)

parameter-list-0  = "(", [ parameter-0,
                    { ",", parameter-0 }, [ "," ] ], ")" ;
parameter-0       = [ attribute-list-0 ], [ "mut" ], identifier, ":", type-0 ;

parameter-list-1  = "(", [ parameter-1,
                    { ",", parameter-1 }, [ "," ] ], ")" ;
parameter-1       = [ attribute-list-1 ], [ "mut" ], identifier, ":", type-1 ;

(* No parameter marker distinguishes values from expressions. In compiler
   calls, arguments determine the binding kind under specification 9.7.1.
   A plain let in an executing compiler function holds an actual value.
   An expression binding has no value slot even if its parameter spells mut.
   compiler::is_expr_param(parameter) queries the per-call binding metadata;
   it is available to if1 without reading the argument. In runtime preparation
   it is false for ordinary parameters. compiler::expr(parameter) extracts
   compiler::Text from an expression binding during compiler execution.
   Both accept a parameter name, optionally parenthesized; neither is a
   first-class function. HUC0 has neither expression bindings nor these queries. *)

(* A slot's mut precedes its name; a pointee's mut stays inside the type.
   Variables and parameters always spell name: type. Inference uses : auto
   only where the language specification permits it, not an omitted type.
   Comma-separated lists allow one optional final comma after an item.
   An empty list has no comma. Conditions, grouped expressions, subscripts,
   and the single type operand of as/ptr_as/size_of/align_of/is_basic are
   not such lists. raw_storage's type and count form a two-item list. *)

block-0           = "{", { statement-0 }, "}" ;
statement-0       = block-0
                  | local-let-decl-0
                  | if-statement-0
                  | while-statement-0
                  | for-statement-0
                  | return-statement-0
                  | "break", ";"
                  | "continue", ";"
                  | expression-statement-0 ;

local-let-binding-0
                  = "let", [ attribute-list-0 ], [ "mut" ], identifier,
                    ":", ( type-0 | "auto" ),
                    [ "=", expression-0 ] ;
local-let-decl-0  = local-let-binding-0, ";" ;
if-statement-0    = "if", [ attribute-list-0 ], "(", expression-0, ")",
                    block-0,
                    [ "else", [ attribute-list-0 ],
                      ( block-0 | if-statement-0 ) ] ;
while-statement-0 = "while", [ attribute-list-0 ], "(", expression-0, ")",
                    block-0 ;
for-header-0      = "for", [ attribute-list-0 ], "(", [ for-init-0 ], ";",
                    [ expression-0 ], ";", [ for-updates-0 ], ")" ;
for-init-0        = local-let-binding-0 | expression-0 ;
for-updates-0     = expression-0, { ",", expression-0 }, [ "," ] ;
for-statement-0   = for-header-0, block-0 ;
return-statement-0
                  = "return", [ expression-0 ], ";" ;
expression-statement-0
                  = expression-0, ";" ;

block-1           = "{", { statement-1 }, "}" ;
statement-1       = block-1
                  | local-let-decl-1
                  | let1-decl
                  | generic-let-decl
                  | phase-control-item
                  | phase-expression-item
                  | insertion-item
                  | if-statement-1
                  | while-statement-1
                  | for-statement-1
                  | return-statement-1
                  | "break", ";"
                  | "continue", ";"
                  | expression-statement-1 ;

local-let-binding-1
                  = "let", [ attribute-list-1 ], [ "mut" ], identifier,
                    ":", ( type-1 | "auto" ),
                    [ "=", expression-1 ] ;
local-let-decl-1  = local-let-binding-1, ";" ;
if-statement-1    = "if", [ attribute-list-1 ], "(", expression-1, ")",
                    block-1,
                    [ "else", [ attribute-list-1 ],
                      ( block-1 | if-statement-1 ) ] ;
while-statement-1 = "while", [ attribute-list-1 ], "(", expression-1, ")",
                    block-1 ;
for-header-1      = "for", [ attribute-list-1 ], "(", [ for-init-1 ], ";",
                    [ expression-1 ], ";", [ for-updates-1 ], ")" ;
for-init-1        = local-let-binding-1 | expression-1 ;
for-updates-1     = expression-1, { ",", expression-1 }, [ "," ] ;
for-statement-1   = for-header-1, block-1 ;

(* The initialization clause has at most one binding or one expression.
   Its binding is scoped to the loop. for1 uses let1; ordinary for uses let,
   including when the ordinary loop executes in the compiler. The update
   clause is an ordered expression list, not a general comma operator.
   Each update is a separate full expression. No declaration list, condition
   declaration, update declaration, or range-based header is provided. *)
return-statement-1
                  = "return", [ expression-1 ], ";" ;
expression-statement-1
                  = expression-1, ";" ;

(* ---------- Expressions ---------- *)

expression-0      = assignment-expression-0 ;
assignment-expression-0
                  = conditional-expression-0,
                    [ assignment-op, assignment-expression-0 ] ;
conditional-expression-0
                  = binary-expression-0,
                    [ "?", expression-0, ":", conditional-expression-0 ] ;
binary-expression-0
                  = unary-expression-0,
                    { binary-op, unary-expression-0 } ;
unary-expression-0
                  = postfix-expression-0
                  | ( "+" | "-" | "!" | "~" | "*" | "&" ),
                    unary-expression-0
                  | "copy", unary-expression-0 ;
postfix-expression-0
                  = primary-expression-0,
                    { argument-list-0
                    | "[", expression-0, "]"
                    | ".", identifier
                    | "->", identifier
                    | "++"
                    | "--" } ;
argument-list-0   = "(", [ expression-0,
                    { ",", expression-0 }, [ "," ] ], ")" ;
primary-expression-0
                  = symbol-path
                  | builtin-type
                  | raw-storage-type-0
                  | literal
                  | "this"
                  | "null"
                  | "(", expression-0, ")"
                  | type-intrinsic-call-0 ;

type-intrinsic-call-0
                  = ( "as" | "ptr_as" | "size_of" | "align_of" | "is_basic" ),
                    "<", type-0, ">", argument-list-0 ;

expression-1      = assignment-expression-1 ;
assignment-expression-1
                  = conditional-expression-1,
                    [ assignment-op, assignment-expression-1 ] ;
conditional-expression-1
                  = binary-expression-1,
                    [ "?", expression-1, ":", conditional-expression-1 ] ;
binary-expression-1
                  = unary-expression-1,
                    { binary-op, unary-expression-1 } ;
unary-expression-1
                  = postfix-expression-1
                  | ( "+" | "-" | "!" | "~" | "*" | "&" | "@" ),
                    unary-expression-1
                  | "copy", unary-expression-1 ;
postfix-expression-1
                  = primary-expression-1,
                    { argument-list-1
                    | phase-argument-list
                    | "[", expression-1, "]"
                    | "::", identifier
                    | ".", identifier
                    | "->", identifier
                    | "++"
                    | "--" } ;
argument-list-1   = "(", [ expression-1,
                    { ",", expression-1 }, [ "," ] ], ")" ;
primary-expression-1
                  = symbol-path
                  | builtin-type
                  | raw-storage-type-1
                  | literal
                  | "this"
                  | "null"
                  | "(", expression-1, ")"
                  | type-intrinsic-call-1 ;

type-intrinsic-call-1
                  = ( "as" | "ptr_as" | "size_of" | "align_of" | "is_basic" ),
                    "<", type-1, ">", argument-list-1 ;

assignment-op     = "=" | "+=" | "-=" | "*=" | "/=" | "%="
                  | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

binary-op         = "||" | "&&"
                  | "|" | "^" | "&"
                  | "==" | "!="
                  | "<" | ">" | "<=" | ">="
                  | "<<" | ">>"
                  | "+" | "-"
                  | "*" | "/" | "%" ;

(* binary-op is written compactly here. The binding powers and left/right
   associativity are those specified by the Pratt-parser table in the
   implementation and language specification. Unary & takes an eligible
   data place's typed address, including pointer slots; binary & remains bitwise AND.
   construct_at(pointer, value) and destruct_at(pointer)
   are compiler-known, non-overloadable ordinary call forms with unqualified
   names. Semantic analysis checks their arity and operands. construct_at
   infers T from mut T*, treats value as an initializer for that slot rather
   than a by-value parameter, and returns mut T*. destruct_at requires mut T*
   and returns void. They have no angle-delimited type operand.
   ptr_as has exactly one value operand. It permits raw-pointer to raw-pointer,
   raw-pointer to usize, and usize to raw-pointer casts; other pairs are rejected.
   size_of/align_of/is_basic take no value
   operands and return target usize/usize/bool constants respectively.
   storage_ptr(pointer) is another compiler-known ordinary call: one pointer
   to raw_storage<T, N> produces an element pointer with the storage's access
   permission, without constructing or reading an element. *)

literal           = integer-literal
                  | float-literal
                  | string-sequence
                  | character-literal
                  | "true"
                  | "false" ;
string-sequence   = string-literal, { string-literal } ;

identifier        = ? ASCII identifier token ? ;
integer-literal   = ? integer literal token ? ;
float-literal     = ? floating-point literal token ? ;
string-literal    = ? UTF-8 string literal token ? ;
character-literal = ? character or byte literal token ? ;

(* Numeric tokens allow an optional single underscore between adjacent digits
   valid for that digit sequence's base. This applies to integer, fractional,
   and exponent digit sequences, but not across a base prefix, decimal point,
   exponent marker or sign, or type suffix. Separators do not change the value
   or type. Repeated or trailing separators are errors. See specification 3.2.
   Whitespace separates tokens but does not select operator roles or blocks;
   formatting recommendations are not additional grammar rules. *)
